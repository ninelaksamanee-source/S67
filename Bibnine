local function addToggle(page, text, default, callback)
	local row = new("Frame", {Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = ITEM}, page, 8)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = WHITE,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	}, row)
	local pill = new("Frame", {
		Size = UDim2.new(0, 40, 0, 20),
		Position = UDim2.new(1, -52, 0.5, -10),
		BackgroundColor3 = OFF,
	}, row, 10)
	local knob = new("Frame", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(0, 2, 0.5, -8),
		BackgroundColor3 = WHITE,
	}, pill, 8)
	local click = new("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = ""}, row)

	local state = default
	local function render()
		local info = TweenInfo.new(0.15)
		TweenService:Create(knob, info, {
			Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
		}):Play()
		TweenService:Create(pill, info, {BackgroundColor3 = state and ACCENT or OFF}):Play()
	end
	render()
	click.MouseButton1Click:Connect(function()
		state = not state
		render()
		callback(state)
	end)
	return function(v)
		state = v
		render()
	end
end

local function addSlider(page, text, min, max, default, callback)
	local row = new("Frame", {Size = UDim2.new(1, -6, 0, 54), BackgroundColor3 = ITEM}, page, 8)
	new("TextLabel", {
		Size = UDim2.new(1, -70, 0, 24),
		Position = UDim2.new(0, 12, 0, 4),
		BackgroundTransparency = 1,
		Text = text,
		TextColor3 = WHITE,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local val = new("TextLabel", {
		Size = UDim2.new(0, 50, 0, 24),
		Position = UDim2.new(1, -62, 0, 4),
		BackgroundTransparency = 1,
		Text = tostring(default),
		TextColor3 = ACCENT,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local bar = new("Frame", {
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.new(0, 12, 0, 36),
		BackgroundColor3 = OFF,
	}, row, 3)
	local fill = new("Frame", {
		Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = ACCENT,
	}, bar, 3)

	local sliding = false
	local function update(x)
		local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		local v = math.floor(min + a * (max - min) + 0.5)
		fill.Size = UDim2.new(a, 0, 1, 0)
		val.Text = tostring(v)
		callback(v)
	end
	bar.InputBegan:Connect(function(i)
		if isPress(i) then
			sliding = true
			update(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if sliding and isMove(i) then
			update(i.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if isPress(i) then sliding = false end
	end)
end


local pg5 = addTab("ภาพ")

local clayOn = false
local origMaterials = setmetatable({}, {__mode = "k"})
local origLighting = {
	Brightness = Lighting.Brightness,
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
}

local function getFx(class, name)
	local o = Lighting:FindFirstChild(name)
	if not o then
		o = Instance.new(class)
		o.Name = name
		o.Parent = Lighting
	end
	return o
end

local cc = getFx("ColorCorrectionEffect", "ClayColor")
local blur = getFx("BlurEffect", "ClayBlur")
local bloom = getFx("BloomEffect", "ClayBloom")
cc.Enabled, blur.Enabled, bloom.Enabled = false, false, false
cc.Saturation, cc.Contrast, cc.Brightness = 0.25, 0.05, 0.03
cc.TintColor = Color3.fromRGB(255, 245, 235)
blur.Size = 2
bloom.Intensity, bloom.Size, bloom.Threshold = 0.3, 20, 1.8

local function smooth(part)
	if part:IsA("BasePart") and not part:IsA("Terrain") then
		if not origMaterials[part] then
			origMaterials[part] = part.Material
		end
		part.Material = Enum.Material.SmoothPlastic
	end
end

local smoothConn
local function setClay(on)
	clayOn = on
	cc.Enabled, blur.Enabled, bloom.Enabled = on, on, on
	if on then
		Lighting.Brightness = 2.5
		Lighting.Ambient = Color3.fromRGB(150, 140, 135)
		Lighting.OutdoorAmbient = Color3.fromRGB(170, 160, 150)
		Lighting.EnvironmentSpecularScale = 0
		for _, v in ipairs(workspace:GetDescendants()) do
			smooth(v)
		end
		if smoothConn then smoothConn:Disconnect() end
		smoothConn = workspace.DescendantAdded:Connect(smooth)
	else
		if smoothConn then smoothConn:Disconnect() smoothConn = nil end
		for k, v in pairs(origLighting) do
			Lighting[k] = v
		end
		for part, mat in pairs(origMaterials) do
			if part.Parent then part.Material = mat end
		end
		origMaterials = setmetatable({}, {__mode = "k"})
	end
end


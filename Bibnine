local function new(class, props, parent, radius)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	if radius then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, radius)
		c.Parent = o
	end
	return o
end

local function getChar()
	local c = player.Character
	if c then
		return c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
	end
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

-- ===== บิน / วิ่งเร็ว =====
local function applyWalk()
	local hum = getChar()
	if hum then
		hum.WalkSpeed = speedOn and walkSpeed or defaultWalk
	end
end

local function stopFly()
	flying = false
	if bv then bv:Destroy() bv = nil end
	if bg then bg:Destroy() bg = nil end
	local hum = getChar()
	if hum then
		hum.PlatformStand = false
	end
end

local function startFly()
	local hum, root = getChar()
	if not (hum and root) then return end
	flying = true
	hum.PlatformStand = true
	bv = new("BodyVelocity", {MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.new()}, root)
	bg = new("BodyGyro", {MaxTorque = Vector3.new(1e5, 1e5, 1e5), P = 1e4, CFrame = root.CFrame}, root)
end

-- ===== มองทะลุ =====
local espObjs = {}

local function clearEsp(plr)
	if espObjs[plr] then
		for _, o in ipairs(espObjs[plr]) do
			o:Destroy()
		end
		espObjs[plr] = nil
	end
end

local function updateEsp(plr)
	clearEsp(plr)
	if not espOn or plr == player then return end
	if espTeam and plr.Team and plr.Team == player.Team then return end
	local char = plr.Character
	local head = char and char:FindFirstChild("Head")
	if not head then return end
	local list = {}
	list[1] = new("Highlight", {
		FillColor = Color3.fromRGB(255, 70, 70),
		FillTransparency = 0.6,
		OutlineColor = WHITE,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	}, char)
	if espNames then
		local bb = new("BillboardGui", {
			Size = UDim2.new(0, 120, 0, 20),
			StudioOffset = Vector3.new(0, 2.5, 0),
			AlwaysOnTop = true,
			Adornee = head,
		}, char)
		new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = plr.DisplayName,
			TextColor3 = WHITE,
			TextStrokeTransparency = 0.4,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
		}, bb)
		list[2] = bb
	end
	espObjs[plr] = list
end

local function refreshEsp()
	for _, p in ipairs(Players:GetPlayers()) do
		updateEsp(p)
	end
end

local function hookPlayer(p)
	p.CharacterAdded:Connect(function()
		task.wait(0.5)
		updateEsp(p)
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	hookPlayer(p)
end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(clearEsp)

-- ===== ล็อกเป้า =====
local function isBlocked(part, char)
	if not aimWall then return false end
	local params = RaycastParams.new()
	params.FilterDescendantsInstances = {player.Character}
	params.FilterType = Enum.RaycastFilterType.Exclude
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, part.Position - origin, params)
	return hit ~= nil and not hit.Instance:IsDescendantOf(char)
end

local function findTarget()
	local center = camera.ViewportSize / 2
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			if not (aimTeam and p.Team and p.Team == player.Team) then
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				local part = p.Character:FindFirstChild(aimPartName) or p.Character:FindFirstChild("HumanoidRootPart")
				if hum and hum.Health > 0 and part then
					local pos, onScreen = camera:WorldToViewportPoint(part.Position)
					if onScreen then
						local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
						if d <= aimFov and (not bestDist or d < bestDist) and not isBlocked(part, p.Character) then
							best, bestDist = part, d
						end
					end
				end
			end
		end
	end
	return best
end


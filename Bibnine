-- ===== ลูปหลัก =====
RunService.RenderStepped:Connect(function()
	if flying and bv and bg then
		local hum = getChar()
		if hum then
			local cf = camera.CFrame
			local move = cf:VectorToObjectSpace(hum.MoveDirection)
			bv.Velocity = (cf.LookVector * -move.Z + cf.RightVector * move.X) * flySpeed
			bg.CFrame = cf
		end
	end

	if aimOn and (aimAlways or UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)) then
		local target = findTarget()
		if target then
			local alpha = math.clamp((101 - aimSmooth) / 100, 0.02, 1)
			local goal = CFrame.new(camera.CFrame.Position, target.Position)
			camera.CFrame = camera.CFrame:Lerp(goal, alpha)
		end
	end
end)

